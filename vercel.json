{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "artifacts/movie-api-docs/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "pnpm --filter @workspace/movie-api-docs run build",
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
